# Chord Palette — client-safe runtime config (EXPO_PUBLIC_*)
#
# These are injected into `extra` by app.config.ts and read via src/lib/env.ts.
# All values here are PUBLISHABLE client keys (safe to ship in the app bundle):
#   - RevenueCat iOS *public* SDK key (starts with "appl_")
#   - Sentry DSN (public ingestion endpoint)
# Do NOT put private/secret keys (RevenueCat secret API key, Sentry auth token) here.
#
# Local usage:   copy to `.env` and fill in real values (`.env` is gitignored).
# EAS Cloud:     set the same variables as EAS environment variables so cloud
#                builds can read them, e.g.:
#                  eas env:create --name EXPO_PUBLIC_REVENUECAT_IOS_KEY --value appl_xxx \
#                    --environment production --environment preview --visibility sensitive
#                  eas env:create --name EXPO_PUBLIC_SENTRY_DSN --value https://... \
#                    --environment production --environment preview --visibility sensitive

# RevenueCat iOS public SDK key (RevenueCat dashboard → Project → API keys → Apple)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Sentry DSN (Sentry project → Settings → Client Keys (DSN))
EXPO_PUBLIC_SENTRY_DSN=

# PostHog project API key (public). Host defaults to US cloud.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Not used in v1 (reserved for later phases) ---
# EXPO_PUBLIC_CONVEX_URL=
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
