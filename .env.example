# Chord Palette — environment variables (example)
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Client-safe values must be prefixed with EXPO_PUBLIC_ (they are embedded in the app bundle).
# Secret keys (R2, Convex deploy, RevenueCat/Clerk/Sentry server secrets) live server-side only
# and must NOT be placed here or shipped in the client.

# --- Phase 4+: analytics / crash / billing (client-safe) ---
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# --- Phase 5+: backend / auth (client-safe) ---
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Local dev tools (server-side / CLI only — NEVER EXPO_PUBLIC_) ---
# Used by Claude Code (@planner / @generator / …) and other local scripts.
# Prefer `.claude/settings.local.json` for Claude Code (see README).
ANTHROPIC_API_KEY=
