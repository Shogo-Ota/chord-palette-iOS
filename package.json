  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "audition": "jest -c scripts/audition/jest.audition.config.js --testPathPattern audition.harness",
    "audition:playback": "jest -c scripts/audition/jest.audition.config.js --testPathPattern playbackRegression.harness",
    "audition:isolate": "jest -c scripts/audition/jest.audition.config.js --testPathPattern qualityIsolation.harness",
    "midi:qa": "jest -c scripts/midiQa/jest.midiQa.config.js --testPathPattern midiQa.harness",
    "pop909:poc": "jest -c scripts/pop909/jest.pop909.config.js --testPathPattern runPoc.harness",
    "preference:collect": "jest -c scripts/preference/jest.preference.config.js --testPathPattern collect.harness",
    "preference:analyze": "jest -c scripts/preference/jest.preference.config.js --testPathPattern analyze.harness",
    "groove:collect": "jest -c scripts/groovePreference/jest.groovePreference.config.js --testPathPattern collect.harness",
    "groove:analyze": "jest -c scripts/groovePreference/jest.groovePreference.config.js --testPathPattern analyze.harness",
    "city:forensic": "jest -c scripts/city/jest.city.config.js --testPathPattern cityForensic.harness",
    "city:poc": "jest -c scripts/city/jest.city.config.js --testPathPattern cityPoc.harness",
    "city:qa": "jest -c scripts/city/jest.city.config.js --testPathPattern cityQa.harness",
    "city:listening": "jest -c scripts/city/jest.city.config.js --testPathPattern cityListening.harness",
    "quality:audit": "jest -c scripts/quality/jest.quality.config.js --testPathPattern architectureAudit.harness",
    "quality:gate01": "jest -c scripts/quality/jest.quality.config.js --testPathPattern gate01Sustain.harness",
    "quality:sharedVoicingPoc": "jest -c scripts/quality/jest.quality.config.js --testPathPattern sharedVoicingPoc.harness",
    "quality:localAnalysis": "jest -c scripts/quality/jest.localAnalysis.config.js"
  },
  "private": true
}
