# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Claude Code — personal API key (never commit)
.claude/settings.local.json

# temporary export / verification output
dist-check/

# off-device audition output (.mid + metrics report) — regenerate with `npm run audition`
audition-out/

# Reference performances are third-party material: analyse them locally and
# commit only the extracted features (see project/docs/music/GroundTruthMidi.md).
*.mid
*.midi

# Teacher MIDI files stay local (rights ledger: docs/style_datasets/midi_registry.json,
# policy: docs/midi_dataset_policy.md). Only relativized LibraryPattern JSON is committed.
assets_dev/midi_teacher/

# Groove MIDI Dataset raw files (CC BY 4.0) — analyse locally; commit stats only.
# Acquisition: docs/data_collection/gmd_acquisition.md
assets_dev/gmd/

# Local source / analysis data
LocalDatasets/
LocalAnalysis/

# EAS build logs — read locally, never a repo artifact
eas-build-*.log

# App Store submission screenshots (regenerated per release)
スクリーンショット/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
